# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_application_id_here

# HCNSEC AI
HCNSEC_API_KEY=your_hcnsec_api_key_here
HCNSEC_MODEL=auto
HCNSEC_API_URL=https://api.hcnsec.cn/v1/chat/completions
HCNSEC_MAX_TOKENS=600
HCNSEC_TIMEOUT_SECONDS=60
HCNSEC_RETRY_ATTEMPTS=3
HCNSEC_RETRY_BASE_DELAY_SECONDS=2
HCNSEC_RETRY_MAX_DELAY_SECONDS=15

# Bot behavior defaults
DEFAULT_RESPONSE_PROBABILITY=0.35
GLOBAL_COOLDOWN_SECONDS=8
PER_USER_COOLDOWN_SECONDS=45
PER_CHANNEL_COOLDOWN_SECONDS=20
MAX_REPLIES_PER_MINUTE=6
CONTEXT_MAX_MESSAGES=50
CONTEXT_MAX_AGE_SECONDS=1800
CONTEXT_MAX_CHARS=5000

# Database
DATABASE_PATH=./bot/data/troll_bot.db

# Logging
LOG_LEVEL=INFO

# Comma-separated Discord user IDs that can control bot admin commands
BOT_ADMIN_USER_IDS=
